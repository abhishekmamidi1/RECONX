# Copy to .env before docker compose up. All values below are dev placeholders.

# --- Postgres (required by compose; no defaults allowed for credentials) ---
POSTGRES_USER=recon
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=reconciliation

# Host port to expose Postgres on (change if 5432 clashes on your machine)
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development`nAPP_VERSION=0.6.0
LOG_LEVEL=INFO

# Comma-separated list or JSON array of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_SIZE_MB=25

# Fallback identity used for audit_logs when no X-Actor header is supplied.
# Replace with real auth (JWT/OIDC subject) in a later phase.
DEFAULT_ACTOR=system

# --- Frontend (dev container only) ---
# Target the backend service inside the compose network
VITE_API_PROXY=http://backend:8000
DOCKER_ENV=1

# --- Phase 3: semantic matching + AI reasoning ---
# Providers: "hashing"/"heuristic" are deterministic offline doubles used by
# the test suite; "ollama" calls a local model server (docker compose --profile models up ollama).
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
REASONING_PROVIDER=heuristic
REASONING_API_URL=http://ollama:11434
REASONING_MODEL=qwen3:0.6b
REASONING_TIMEOUT_S=60
SEMANTIC_INDEX_PATH=/app/data/semantic_index.faiss

# Bare-metal (non-Docker) local runs:
#   set POSTGRES_HOST=localhost, VITE_API_PROXY=http://localhost:8000,
#   unset DOCKER_ENV. The backend builds DATABASE_URL from the POSTGRES_* vars;
#   export DATABASE_URL to override it entirely.

# --- Phase 5: ERP webhook integration ---
# Target for POST /api/v1/integrations/erp/push. Leave empty to disable.
# For local end-to-end testing, point it at the built-in mock receiver:
#   ERP_WEBHOOK_URL=http://backend:8000/mock/erp/webhook
ERP_WEBHOOK_URL=
